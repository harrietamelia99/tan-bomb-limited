<section id="reels" class="section section--reels fade-in">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <h2 class="section__heading text-center">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="section--reels__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}
    <div class="reels-grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign reel_label = block.settings.label
          assign reel_image = block.settings.image
          assign reel_alt = block.settings.label
          assign reel_fallback = 'lifestyle-arm-cream.jpg'
          if settings.vanilla_creme_coming_soon
            assign label_lower = block.settings.label | downcase
            if label_lower contains 'vanilla'
              assign reel_label = 'Coming Soon'
              assign reel_image = blank
              assign reel_alt = 'Coming soon reel preview'
              assign reel_fallback = 'lifestyle-cream-still.jpg'
            endif
          endif
        -%}
        <a class="reel-card" href="{{ block.settings.link | default: section.settings.profile_url }}" target="_blank" rel="noopener noreferrer" {{ block.shopify_attributes }}>
          {%- if reel_image != blank -%}
            <img src="{{ reel_image | image_url: width: 600 }}" alt="{{ reel_alt | escape }}" width="540" height="960" loading="lazy">
          {%- else -%}
            <img src="{{ reel_fallback | asset_url }}" alt="{{ reel_alt | escape }}" width="540" height="960" loading="lazy">
          {%- endif -%}
          <span class="reel-card__play" aria-hidden="true">▶</span>
          {%- if reel_label != blank -%}
            <span class="reel-card__label">{{ reel_label }}</span>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
    {%- if section.settings.follow_label != blank -%}
      <div class="section--reels__actions">
        <a href="{{ section.settings.profile_url }}" class="btn btn--outline-light" target="_blank" rel="noopener noreferrer">{{ section.settings.follow_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Reels grid",
  "settings": [
    { "type": "html", "id": "heading", "label": "Heading", "default": "On the <em>feed</em>" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Lifestyle reels and drops from @tanbombltd - swap these slots as new clips land." },
    { "type": "url", "id": "profile_url", "label": "Profile URL" },
    { "type": "text", "id": "follow_label", "label": "Follow button", "default": "Follow @tanbombltd" }
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "Reel",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image / poster" },
        { "type": "text", "id": "label", "label": "Label", "default": "Lifestyle" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reels grid",
      "blocks": [
        { "type": "reel", "settings": { "label": "Lifestyle" } },
        { "type": "reel", "settings": { "label": "Application" } },
        { "type": "reel", "settings": { "label": "Cherry Whip" } },
        { "type": "reel", "settings": { "label": "Vanilla Crème" } }
      ]
    }
  ]
}
{% endschema %}
