<section
  id="wholesale"
  class="section section--brand-story fade-in{% if section.settings.image_position == 'left' %} section--brand-story--image-left{% endif %}"
>
  <div class="container section--brand-story__inner">
    <div class="section--brand-story__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="section--brand-story__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="section__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.pull_quote != blank -%}
        <blockquote class="section--brand-story__pull-quote">
          <p><em>{{ section.settings.pull_quote }}</em></p>
        </blockquote>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <div class="section--brand-story__body rte">
          {{ section.settings.body }}
        </div>
      {%- endif -%}

      <a href="{{ routes.root_url }}?enquiry=Wholesaler#contact" class="btn btn--primary section--brand-story__cta" data-enquiry-type="Wholesaler">Enquire about wholesale</a>
    </div>

    <div class="section--brand-story__media">
      {%- if section.settings.image != blank -%}
        <img
          src="{{ section.settings.image | image_url: width: 800 }}"
          srcset="
            {{ section.settings.image | image_url: width: 400 }} 400w,
            {{ section.settings.image | image_url: width: 600 }} 600w,
            {{ section.settings.image | image_url: width: 800 }} 800w
          "
          sizes="(max-width: 767px) 90vw, 40vw"
          alt="{{ section.settings.image.alt | default: 'Tan Bomb wholesale' }}"
          width="800"
          height="1000"
          loading="lazy"
          class="section--brand-story__image"
        >
      {%- else -%}
        <img
          src="{{ 'cherry-whip-shelf-2x.jpg' | asset_url }}"
          alt="Tan Bomb Cherry Whip tube and box on a retail shelf"
          width="1382"
          height="1848"
          loading="lazy"
          class="section--brand-story__image"
        >
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand story",
  "tag": "section",
  "class": "section-brand-story",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Wholesale"
    },
    {
      "type": "html",
      "id": "heading",
      "label": "Heading",
      "default": "Stock <em>Tan Bomb</em>"
    },
    {
      "type": "text",
      "id": "pull_quote",
      "label": "Pull quote",
      "default": "Get your customers Tan BOMBED."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Our wholesale offering is exclusively for wholesalers purchasing in bulk, with trade pricing and retail-ready packaging across the Tan Bomb range.</p><p>From Cherry Whip and Vanilla Crème to the next limited drop - one recognisable brand, multiple scents.</p><p>Shopping for yourself? Our full range is also available to buy directly through our <a href=\"/shop\">online shop</a>.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "left"
    }
  ],
  "presets": [
    {
      "name": "Brand story"
    }
  ]
}
{% endschema %}
