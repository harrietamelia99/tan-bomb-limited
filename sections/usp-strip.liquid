<section class="usp-strip{% if section.settings.style == 'dark' %} usp-strip--dark{% endif %}" aria-label="{{ section.settings.heading | default: 'Why Tan Bomb' }}">
  <div class="container">
    <div class="usp-strip__grid">
      {%- for block in section.blocks -%}
        <div class="usp-item" {{ block.shopify_attributes }}>
          <svg class="usp-item__icon" viewBox="0 0 48 48" fill="none" aria-hidden="true">
            <circle cx="24" cy="24" r="14" stroke="currentColor" stroke-width="1.5"/>
            <path d="M24 16v8l5 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <p class="usp-item__label">{{ block.settings.label }}</p>
        </div>
      {%- else -%}
        <div class="usp-item"><p class="usp-item__label">Made in the UK</p></div>
        <div class="usp-item"><p class="usp-item__label">Salon Created</p></div>
        <div class="usp-item"><p class="usp-item__label">Fast Results Formula</p></div>
        <div class="usp-item"><p class="usp-item__label">Skin-Loving Care</p></div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "USP strip",
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" }
      ],
      "default": "dark"
    },
    { "type": "text", "id": "heading", "label": "Accessible label", "default": "Why Tan Bomb" }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "USP",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Made in the UK" }
      ]
    }
  ],
  "presets": [
    {
      "name": "USP strip",
      "blocks": [
        { "type": "usp", "settings": { "label": "Made in the UK" } },
        { "type": "usp", "settings": { "label": "Salon Created" } },
        { "type": "usp", "settings": { "label": "Fast Results Formula" } },
        { "type": "usp", "settings": { "label": "Skin-Loving Care" } }
      ]
    }
  ]
}
{% endschema %}
