{%- liquid
  assign seo_brand = 'Tan Bomb'
  assign seo_site = shop.url | default: 'https://www.tan-bomb.com'
  assign seo_title_final = seo_title | default: page_title
  if template.name == 'index' or seo_title_final == blank
    assign seo_title_final = 'Tan Bomb | Official Site – Luxury Tanning Accelerators'
  elsif seo_title_final contains seo_brand
    assign seo_title_final = seo_title_final
  else
    assign seo_title_final = seo_title_final | append: ' | Tan Bomb'
  endif
  assign seo_desc_final = seo_description | default: page_description
  if seo_desc_final == blank
    assign seo_desc_final = 'Official Tan Bomb site. UK-made luxury tanning accelerators for home and salon – Cherry Whip, Vanilla Crème and limited editions. Free UK delivery.'
  endif
  assign seo_canon = seo_canonical | default: canonical_url
  if seo_image != blank
    assign seo_img = seo_image
  else
    assign seo_img = 'og-image.png' | asset_url | prepend: 'https:'
  endif
  assign seo_og_type = seo_type | default: 'website'
-%}
<meta name="description" content="{{ seo_desc_final | escape }}">
<meta name="author" content="Tan Bomb">
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
<link rel="canonical" href="{{ seo_canon }}">

<meta property="og:type" content="{{ seo_og_type }}">
<meta property="og:site_name" content="Tan Bomb">
<meta property="og:locale" content="en_GB">
<meta property="og:url" content="{{ seo_canon }}">
<meta property="og:title" content="{{ seo_title_final | escape }}">
<meta property="og:description" content="{{ seo_desc_final | escape }}">
<meta property="og:image" content="{{ seo_img }}">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ seo_title_final | escape }}">
<meta name="twitter:description" content="{{ seo_desc_final | escape }}">
<meta name="twitter:image" content="{{ seo_img }}">

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": {{ seo_site | append: '/#organization' | json }},
      "name": "Tan Bomb",
      "alternateName": ["TanBomb", "tan bomb"],
      "url": {{ seo_site | json }},
      "logo": {
        "@type": "ImageObject",
        "url": {{ 'logo.png' | asset_url | json }}
      },
      "email": "info@tan-bomb.com",
      "description": "Tan Bomb makes UK luxury tanning accelerators for home and salon use."
    },
    {
      "@type": "WebSite",
      "@id": {{ seo_site | append: '/#website' | json }},
      "name": "Tan Bomb",
      "url": {{ seo_site | json }},
      "publisher": { "@id": {{ seo_site | append: '/#organization' | json }} },
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ seo_site | append: '/shop?q={search_term_string}' | json }},
        "query-input": "required name=search_term_string"
      }
    }
  ]
}
</script>
